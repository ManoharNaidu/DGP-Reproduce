# Copy to .env and fill in. Never commit .env.

# Hugging Face: Qwen/Qwen3-8B and microsoft/deberta-v3-base are NOT gated,
# so a token is optional. It only raises download rate limits.
HF_TOKEN=

# Where Hugging Face stores model weights (Qwen3-8B is ~16 GB).
HF_HOME=

# Root for datasets/cache/checkpoints if you want them off the repo drive.
DGP_DATA_ROOT=datasets
